PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/easybook
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# GATEWAY=mock for local/demo without keys, razorpay for Razorpay test mode
GATEWAY=mock
# Production refuses GATEWAY=mock unless you opt in (demo deploys only: anyone can "pay" for free)
ALLOW_MOCK_GATEWAY=false
MOCK_GATEWAY_SECRET=change-me-too
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Password for the demo owner created by "npm run seed" (demo only)
SEED_OWNER_PASSWORD=password123
